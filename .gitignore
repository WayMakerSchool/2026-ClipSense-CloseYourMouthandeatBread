# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 대용량 미디어 (참조/테스트 영상 — 저장소에 안 넣음)
*.mp4
*.mov
*.avi

# 생성물 (검증된 WAV 4개는 오프라인 데모용 릴리스 자산으로 포함)
assets/voice/*.mp3
data/*.mp4

# API 키·비밀 (절대 커밋 금지)
.env
*.key
*.jks
*.keystore
secrets.json
config.local.json
app/android/key.properties

# 공모전 신청 원본(개인정보·문서 메타데이터가 있을 수 있어 공개 저장소에서 제외)
임베디드 공모전/

# OS/에디터
.DS_Store
*.swp

# 임시/작업 파일
scratchpad/
*.tmp

# 진행 원장은 스크래치(추적 안 함) — .superpowers는 로컬 상태
.superpowers/

# Flutter (app/)
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/ios/Pods/
app/android/.gradle/

# Claude Code 워크플로 worktree (로컬 전용)
.claude/worktrees/
